<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Biblioteca Secreta</title>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #f3f3f5;
      --header-bg: #111827;
      --dot1-color: #f59e0b;
      --dot2-color: #818cf8;
      --dot3-color: #6b7280;
      --border-color: #374151;
      --card-default-bg: #475569;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Fredoka', 'Quicksand', sans-serif;
    }

    body {
      background-color: var(--bg-color);
      /* Background quadriculado suave */
      background-image: 
        linear-gradient(to right, rgba(200, 200, 220, 0.3) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(200, 200, 220, 0.3) 1px, transparent 1px);
      background-size: 24px 24px;
      min-height: 100vh;
      padding: 20px 10px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    /* Container Principal */
    .app-window {
      width: 100%;
      max-width: 900px;
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      border: 3px solid #111827;
      overflow: hidden;
      margin-bottom: 30px;
    }

    /* Barra Superior da Janela */
    .window-header {
      background-color: var(--header-bg);
      padding: 12px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--border-color);
      transition: background-color 0.3s ease;
    }

    .window-title {
      color: #ffffff;
      font-weight: 700;
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .window-controls {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      display: inline-block;
      transition: background-color 0.3s ease;
    }
    .dot-1 { background-color: var(--dot1-color); }
    .dot-2 { background-color: var(--dot2-color); }
    .dot-3 { background-color: var(--dot3-color); }

    /* Barra de Personalização */
    .customizer-bar {
      background: rgba(17, 24, 39, 0.05);
      border-bottom: 1px solid #e5e7eb;
      padding: 10px 15px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      font-size: 0.85rem;
    }

    .customizer-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .customizer-label {
      font-weight: 600;
      color: #374151;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .color-picker-input {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      width: 28px;
      height: 28px;
      border: 2px solid #ccc;
      border-radius: 50%;
      cursor: pointer;
      background: none;
      padding: 0;
      overflow: hidden;
    }
    .color-picker-input::-webkit-color-swatch-wrapper { padding: 0; }
    .color-picker-input::-webkit-color-swatch { border: none; border-radius: 50%; }

    /* Barra de Ações e Filtros */
    .actions-bar {
      padding: 15px 20px;
      background-color: #f8fafc;
      border-bottom: 1px dashed #cbd5e1;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
    }

    .search-filter-box {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      flex: 1;
    }

    .search-input, .filter-select {
      padding: 8px 14px;
      border: 2px solid #cbd5e1;
      border-radius: 8px;
      font-size: 0.9rem;
      outline: none;
    }

    .search-input {
      flex: 1;
      min-width: 160px;
    }

    .btn {
      padding: 8px 14px;
      border-radius: 8px;
      border: 2px solid #111827;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
      box-shadow: 2px 2px 0px #111827;
    }

    .btn:active {
      transform: translate(2px, 2px);
      box-shadow: 0px 0px 0px #111827;
    }

    .btn-add { background-color: #4ade80; color: #111827; }
    .btn-backup { background-color: #3b82f6; color: #ffffff; }
    .btn-import { background-color: #8b5cf6; color: #ffffff; }
    .btn-restore { background-color: #f43f5e; color: #ffffff; }

    /* Grid de Cards */
    .grid-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px;
      padding: 20px;
    }

    /* Card do Manhwa */
    .card {
      background-color: var(--card-default-bg);
      border-radius: 12px;
      padding: 8px;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      border: 2px solid #111827;
      box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.2);
      position: relative;
      transition: transform 0.2s ease, background-color 0.3s ease;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .card-cover-wrapper {
      position: relative;
      width: 100%;
      height: 240px;
      border-radius: 8px;
      overflow: hidden;
      background-color: #1e293b;
      margin-bottom: 8px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .card-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-title {
      font-size: 1rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 8px;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
      min-height: 2.4em;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1.2;
    }

    .card-details {
      font-size: 0.8rem;
      background: rgba(0, 0, 0, 0.25);
      border-radius: 6px;
      padding: 6px 8px;
      margin-bottom: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .card-details li {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 4px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .card-details a {
      color: #fde047;
      text-decoration: underline;
      font-weight: 700;
    }

    .card-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      gap: 4px;
    }

    .status-badge {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
      margin-left: auto;
    }
    .status-concluido { background-color: #22c55e; color: #fff; }
    .status-andamento { background-color: #3b82f6; color: #fff; }
    .status-hiatus { background-color: #ef4444; color: #fff; }

    .btn-icon {
      background: rgba(255, 255, 255, 0.2);
      border: none;
      color: white;
      border-radius: 4px;
      padding: 3px 6px;
      cursor: pointer;
      font-size: 0.75rem;
    }
    .btn-icon:hover { background: rgba(255, 255, 255, 0.4); }

    /* Modal */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 15px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal {
      background: white;
      border-radius: 12px;
      padding: 20px;
      width: 100%;
      max-width: 420px;
      border: 3px solid #111827;
      box-shadow: 6px 6px 0px #111827;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 15px;
      color: #111827;
    }

    .form-group {
      margin-bottom: 12px;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 4px;
      color: #374151;
    }

    .form-control {
      width: 100%;
      padding: 8px 10px;
      border: 2px solid #cbd5e1;
      border-radius: 6px;
      font-size: 0.9rem;
    }

    .modal-buttons {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 15px;
    }

    .color-picker-wrapper {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .hidden-file-input {
      display: none;
    }

    @media (max-width: 600px) {
      .grid-container {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        padding: 12px;
      }
      .card-cover-wrapper { height: 180px; }
      .actions-bar, .customizer-bar { flex-direction: column; align-items: stretch; }
      .search-filter-box { flex-direction: column; }
    }
  </style>
</head>
<body>

  <!-- Janela Principal -->
  <div class="app-window">
    <!-- Barra Superior -->
    <div class="window-header" id="windowHeader">
      <div class="window-title">
        <span>📖</span> <span id="appTitleText">Biblioteca Secreta</span>
      </div>
      <div class="window-controls">
        <span class="dot dot-1" id="dot1"></span>
        <span class="dot dot-2" id="dot2"></span>
        <span class="dot dot-3" id="dot3"></span>
      </div>
    </div>

    <!-- Barra de Personalização do Topo -->
    <div class="customizer-bar">
      <div class="customizer-group">
        <span class="customizer-label">🎨 Personalizar Topo:</span>
        <label class="customizer-label" title="Cor do Fundo do Topo">
          Fundo: <input type="color" id="headerBgPicker" class="color-picker-input" value="#111827">
        </label>
        <label class="customizer-label" title="Cor da Bolinha 1">
          B1: <input type="color" id="dot1Picker" class="color-picker-input" value="#f59e0b">
        </label>
        <label class="customizer-label" title="Cor da Bolinha 2">
          B2: <input type="color" id="dot2Picker" class="color-picker-input" value="#818cf8">
        </label>
        <label class="customizer-label" title="Cor da Bolinha 3">
          B3: <input type="color" id="dot3Picker" class="color-picker-input" value="#6b7280">
        </label>
      </div>
    </div>

    <!-- Barra de Ações & Filtro -->
    <div class="actions-bar">
      <div class="search-filter-box">
        <input type="text" id="searchInput" class="search-input" placeholder="🔍 Buscar título ou link...">
        <select id="filterStatus" class="filter-select">
          <option value="all">Todos os Status</option>
          <option value="Concluído">Concluídos</option>
          <option value="Andamento">Em Andamento</option>
          <option value="Hiatus">Hiatus</option>
        </select>
      </div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button class="btn btn-add" id="btnOpenAddModal">➕ Novo Card</button>
        <button class="btn btn-backup" id="btnExportBackup" title="Baixar arquivo de segurança com seus manhwas">📥 Backup</button>
        <button class="btn btn-import" id="btnImportBackup" title="Restaurar backup do celular">📤 Restaurar</button>
        <button class="btn btn-restore" id="btnResetDefault" title="Restaurar lista padrão original">🔄 Padronizar</button>
      </div>
    </div>

    <!-- Grid de Cards -->
    <div class="grid-container" id="manhwaGrid"></div>
  </div>

  <input type="file" id="backupFileInput" class="hidden-file-input" accept=".json">

  <!-- Modal Adicionar/Editar -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal">
      <div class="modal-title" id="modalTitle">Adicionar Manhwa</div>
      <form id="manhwaForm">
        <input type="hidden" id="editIndex" value="-1">
        
        <div class="form-group">
          <label for="inputTitle">Título do Manhwa</label>
          <input type="text" id="inputTitle" class="form-control" required placeholder="Ex: Roses and Champagne">
        </div>

        <div class="form-group">
          <label>Capa (Escolher da Galeria/Celular)</label>
          <input type="file" id="inputCoverFile" class="form-control" accept="image/*">
          <small style="color: #64748b; font-size:0.75rem;">Ou cole uma URL de imagem abaixo:</small>
          <input type="url" id="inputCoverUrl" class="form-control" style="margin-top:4px;" placeholder="https://exemplo.com/imagem.jpg">
        </div>

        <div class="form-group">
          <label for="inputStatus">Status</label>
          <select id="inputStatus" class="form-control">
            <option value="Concluído">Concluído</option>
            <option value="Andamento">Andamento</option>
            <option value="Hiatus">Hiatus</option>
          </select>
        </div>

        <div class="form-group">
          <label for="inputCap">Capítulos</label>
          <input type="text" id="inputCap" class="form-control" placeholder="Ex: 55 + 37.5 Side">
        </div>

        <div class="form-group">
          <label for="inputLink">Nome do Link/Acurácia</label>
          <input type="text" id="inputLink" class="form-control" placeholder="Ex: 3xyaoi">
        </div>

        <div class="form-group">
          <label for="inputColor">Cor de Fundo do Card (HEX)</label>
          <div class="color-picker-wrapper">
            <input type="color" id="inputColorPicker" class="color-picker-input" value="#475569">
            <input type="text" id="inputColorHex" class="form-control" style="width: 120px;" value="#475569" placeholder="#475569">
          </div>
        </div>

        <div class="modal-buttons">
          <button type="button" class="btn" style="background:#cbd5e1" id="btnCancelModal">Cancelar</button>
          <button type="submit" class="btn btn-add">Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const initialManhwas = [
      { title: "Roses and Champagne", cover: "https://picsum.photos/seed/roses/300/450", status: "Concluído", cap: "55 + 37.5 Side", link: "fbsquadx", bgColor: "#111827" },
      { title: "Dear Door", cover: "https://picsum.photos/seed/deardoor/300/450", status: "Concluído", cap: "130.5 + 33.5", link: "3xyaoi", bgColor: "#b91c1c" },
      { title: "Xxx Buddy", cover: "https://picsum.photos/seed/xxxbuddy/300/450", status: "Concluído", cap: "103 + 14 Side", link: "3xyaoi", bgColor: "#2563eb" },
      { title: "Mr.A's Farm", cover: "https://picsum.photos/seed/mrafarm/300/450", status: "Hiatus", cap: "24.2", link: "3xyaoi", bgColor: "#334155" },
      { title: "A Lovely Meal", cover: "https://picsum.photos/seed/lovely/300/450", status: "Andamento", cap: "25", link: "3xyaoi", bgColor: "#475569" },
      { title: "Killer Crush", cover: "https://picsum.photos/seed/killercrush/300/450", status: "Concluído", cap: "77 + 4 Side", link: "3xyaoi", bgColor: "#475569" },
      { title: "The Little Pigs", cover: "https://picsum.photos/seed/pigs/300/450", status: "Concluído", cap: "8", link: "3xyaoi", bgColor: "#475569" },
      { title: "The Black Knight Under the Red Curse", cover: "https://picsum.photos/seed/blackknight/300/450", status: "Concluído", cap: "5 + 3 Side", link: "3xyaoi", bgColor: "#1e3a8a" },
      { title: "Like Mother Like Son", cover: "https://picsum.photos/seed/likemother/300/450", status: "Concluído", cap: "8+ 2 Extras", link: "3xyaoi", bgColor: "#64748b" },
      { title: "Hot and Cold", cover: "https://picsum.photos/seed/hotcold/300/450", status: "Concluído", cap: "3", link: "3xyaoi", bgColor: "#64748b" },
      { title: "Help me Teacher!", cover: "https://picsum.photos/seed/helpteacher/300/450", status: "Concluído", cap: "10", link: "3xyaoi", bgColor: "#64748b" },
      { title: "Disorder and Desire", cover: "https://picsum.photos/seed/disorder/300/450", status: "Andamento", cap: "8", link: "3xyaoi", bgColor: "#64748b" }
    ];

    const STORAGE_KEY = 'secret_library_manhwas';
    const THEME_KEY = 'secret_library_theme';

    let manhwas = [];
    let customTheme = {
      headerBg: '#111827',
      dot1: '#f59e0b',
      dot2: '#818cf8',
      dot3: '#6b7280'
    };

    function loadData() {
      const savedData = localStorage.getItem(STORAGE_KEY);
      if (savedData) {
        try {
          manhwas = JSON.parse(savedData);
        } catch(e) {
          manhwas = [...initialManhwas];
        }
      } else {
        manhwas = [...initialManhwas];
      }

      const savedTheme = localStorage.getItem(THEME_KEY);
      if (savedTheme) {
        try {
          customTheme = JSON.parse(savedTheme);
        } catch(e){}
      }
      applyTheme();
    }

    function saveData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(manhwas));
    }

    function saveTheme() {
      localStorage.setItem(THEME_KEY, JSON.stringify(customTheme));
    }

    function applyTheme() {
      document.documentElement.style.setProperty('--header-bg', customTheme.headerBg);
      document.documentElement.style.setProperty('--dot1-color', customTheme.dot1);
      document.documentElement.style.setProperty('--dot2-color', customTheme.dot2);
      document.documentElement.style.setProperty('--dot3-color', customTheme.dot3);

      document.getElementById('headerBgPicker').value = customTheme.headerBg;
      document.getElementById('dot1Picker').value = customTheme.dot1;
      document.getElementById('dot2Picker').value = customTheme.dot2;
      document.getElementById('dot3Picker').value = customTheme.dot3;
    }

    function renderGrid() {
      const grid = document.getElementById('manhwaGrid');
      const searchVal = document.getElementById('searchInput').value.toLowerCase();
      const filterVal = document.getElementById('filterStatus').value;

      grid.innerHTML = '';

      manhwas.forEach((item, index) => {
        const matchesSearch = item.title.toLowerCase().includes(searchVal) || item.link.toLowerCase().includes(searchVal);
        const matchesFilter = filterVal === 'all' || item.status === filterVal;

        if (matchesSearch && matchesFilter) {
          const card = document.createElement('div');
          card.className = 'card';
          if (item.bgColor) {
            card.style.backgroundColor = item.bgColor;
          }

          let badgeClass = 'status-concluido';
          if (item.status === 'Andamento') badgeClass = 'status-andamento';
          if (item.status === 'Hiatus') badgeClass = 'status-hiatus';

          card.innerHTML = `
            <div class="card-cover-wrapper">
              <img src="${item.cover}" class="card-cover" alt="${item.title}" onerror="this.src='https://via.placeholder.com/300x450?text=Sem+Capa'">
            </div>
            <div class="card-title">${item.title}</div>
            <ul class="card-details">
              <li>📌 Status: <i>${item.status}</i></li>
              <li>📖 Cap: ${item.cap}</li>
              <li>🔗 Link: <a href="#" onclick="event.preventDefault();">${item.link}</a></li>
            </ul>
            <div class="card-actions">
              <button class="btn-icon" onclick="editCard(${index})">✏️ Editar</button>
              <button class="btn-icon" onclick="deleteCard(${index})">🗑️ Excluir</button>
              <span class="status-badge ${badgeClass}">${item.status}</span>
            </div>
          `;
          grid.appendChild(card);
        }
      });
    }

    const modalOverlay = document.getElementById('modalOverlay');
    const manhwaForm = document.getElementById('manhwaForm');

    function openModal(index = -1) {
      document.getElementById('editIndex').value = index;
      document.getElementById('inputCoverFile').value = '';
      
      if (index >= 0) {
        const item = manhwas[index];
        document.getElementById('modalTitle').innerText = 'Editar Manhwa';
        document.getElementById('inputTitle').value = item.title;
        document.getElementById('inputCoverUrl').value = item.cover.startsWith('data:') ? '' : item.cover;
        document.getElementById('inputStatus').value = item.status;
        document.getElementById('inputCap').value = item.cap;
        document.getElementById('inputLink').value = item.link;
        const color = item.bgColor || '#475569';
        document.getElementById('inputColorPicker').value = color;
        document.getElementById('inputColorHex').value = color;
      } else {
        document.getElementById('modalTitle').innerText = 'Novo Manhwa';
        manhwaForm.reset();
        document.getElementById('inputColorPicker').value = '#475569';
        document.getElementById('inputColorHex').value = '#475569';
      }
      modalOverlay.classList.add('active');
    }

    function closeModal() {
      modalOverlay.classList.remove('active');
    }

    manhwaForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const index = parseInt(document.getElementById('editIndex').value);
      const fileInput = document.getElementById('inputCoverFile');
      const urlInput = document.getElementById('inputCoverUrl').value;
      
      const saveCardData = (coverSrc) => {
        const cardObj = {
          title: document.getElementById('inputTitle').value,
          cover: coverSrc || 'https://via.placeholder.com/300x450?text=Sem+Capa',
          status: document.getElementById('inputStatus').value,
          cap: document.getElementById('inputCap').value,
          link: document.getElementById('inputLink').value,
          bgColor: document.getElementById('inputColorHex').value
        };

        if (index >= 0) {
          manhwas[index] = cardObj;
        } else {
          manhwas.unshift(cardObj);
        }

        saveData();
        renderGrid();
        closeModal();
      };

      if (fileInput.files && fileInput.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          saveCardData(e.target.result);
        };
        reader.readAsDataURL(fileInput.files[0]);
      } else {
        let existingCover = (index >= 0) ? manhwas[index].cover : '';
        saveCardData(urlInput || existingCover);
      }
    });

    window.editCard = function(index) {
      openModal(index);
    };

    window.deleteCard = function(index) {
      if (confirm(`Deseja mesmo apagar "${manhwas[index].title}"?`)) {
        manhwas.splice(index, 1);
        saveData();
        renderGrid();
      }
    };

    document.getElementById('btnExportBackup').addEventListener('click', function() {
      const dataToExport = {
        manhwas: manhwas,
        theme: customTheme,
        exportDate: new Date().toISOString()
      };
      const jsonStr = JSON.stringify(dataToExport, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      
      const a = document.createElement('a');
      a.href = url;
      a.download = `biblioteca_secreta_backup_${new Date().toISOString().slice(0,10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    const backupFileInput = document.getElementById('backupFileInput');
    document.getElementById('btnImportBackup').addEventListener('click', function() {
      backupFileInput.click();
    });

    backupFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const imported = JSON.parse(event.target.result);
          if (imported.manhwas && Array.isArray(imported.manhwas)) {
            manhwas = imported.manhwas;
            saveData();
          }
          if (imported.theme) {
            customTheme = imported.theme;
            saveTheme();
            applyTheme();
          }
          renderGrid();
          alert('Backup restaurado com sucesso!');
        } catch(err) {
          alert('Erro ao carregar ficheiro de backup. Certifique-se de selecionar um arquivo .json válido.');
        }
      };
      reader.readAsText(file);
      backupFileInput.value = '';
    });

    document.getElementById('btnOpenAddModal').addEventListener('click', () => openModal(-1));
    document.getElementById('btnCancelModal').addEventListener('click', closeModal);
    document.getElementById('searchInput').addEventListener('input', renderGrid);
    document.getElementById('filterStatus').addEventListener('change', renderGrid);

    document.getElementById('btnResetDefault').addEventListener('click', () => {
      if (confirm('Atenção: Isso redefinirá a lista para os 12 manhwas originais! Continuar?')) {
        manhwas = [...initialManhwas];
        saveData();
        renderGrid();
      }
    });

    const picker = document.getElementById('inputColorPicker');
    const hexInput = document.getElementById('inputColorHex');

    picker.addEventListener('input', (e) => hexInput.value = e.target.value);
    hexInput.addEventListener('input', (e) => picker.value = e.target.value);

    document.getElementById('headerBgPicker').addEventListener('input', (e) => {
      customTheme.headerBg = e.target.value;
      applyTheme();
      saveTheme();
    });
    document.getElementById('dot1Picker').addEventListener('input', (e) => {
      customTheme.dot1 = e.target.value;
      applyTheme();
      saveTheme();
    });
    document.getElementById('dot2Picker').addEventListener('input', (e) => {
      customTheme.dot2 = e.target.value;
      applyTheme();
      saveTheme();
    });
    document.getElementById('dot3Picker').addEventListener('input', (e) => {
      customTheme.dot3 = e.target.value;
      applyTheme();
      saveTheme();
    });

    loadData();
    renderGrid();
  </script>
</body>
</html>
